# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/frontend/node_modules/
/backend/vendor/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/frontend/coverage/
/backend/.phpunit.cache/

# next.js
/frontend/.next/
/frontend/out/

# production
/frontend/build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/backend/storage/logs/*.log

# env files (can opt-in for committing if needed)
.env*
!**/.env.example

# vercel
/frontend/.vercel/

# typescript
*.tsbuildinfo
next-env.d.ts
