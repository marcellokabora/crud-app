{
    "name": "ledger/backend",
    "description": "Custom PHP API for the client ledger application",
    "type": "project",
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "serve": "php -S localhost:8080 -t public",
        "lint": "php -l public/index.php",
        "test": "phpunit --configuration phpunit.xml"
    },
    "config": {
        "process-timeout": 0,
        "sort-packages": true
    },
    "require-dev": {
        "phpunit/phpunit": ">=12.0 <13.0"
    }
}